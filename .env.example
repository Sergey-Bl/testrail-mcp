# ── TestRail ────────────────────────────────────────────────────────────────
TESTRAIL_BASE_URL=https://your-org.testrail.io
TESTRAIL_USER=you@example.com
TESTRAIL_API_KEY=your_testrail_api_key
# Defaults for tools that accept project_id/suite_id — handy when you usually
# work in one place.
TESTRAIL_PROJECT_ID=1
TESTRAIL_SUITE_ID=1
# House style for created cases (qa_bot.py defaults shown).
TR_TEMPLATE_ID=2
TR_TYPE_ID=7
TR_PRIORITY_ID=3

# ── Jira (optional — only required for generate_cases_from_jira) ────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER=you@example.com
JIRA_API_TOKEN=your_jira_api_token

# ── Confluence (optional — only required for generate_cases_from_confluence) ─
CONFLUENCE_BASE_URL=https://your-org.atlassian.net
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=your_confluence_api_token

# No ANTHROPIC_API_KEY is needed: LLM work happens in your MCP client (Claude
# Desktop / Cursor / Claude Code / etc.) using your existing Claude subscription.
# This server only fetches data and returns it with instructions for the client.
