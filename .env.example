# TestRail
TESTRAIL_BASE_URL=https://your-org.testrail.io
TESTRAIL_USER=you@example.com
TESTRAIL_API_KEY=your_testrail_api_key

# Jira (optional — only required for generate_cases_from_jira)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER=you@example.com
JIRA_API_TOKEN=your_jira_api_token

# Anthropic — used by case-generation tools
ANTHROPIC_API_KEY=sk-ant-...
CASE_GEN_MODEL=claude-sonnet-4-6
